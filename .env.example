# ダミー値のみ。実際の値は .env に記入し、.env はコミットしない（仕様第12章）

# 32バイト以上のランダム文字列。生成例: python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=CHANGE_ME_dummy_secret_key_do_not_use_in_production

# データ保存先（公開ディレクトリ外）。DB・画像・GLBはこの下に置く
APP_DATA_DIR=./data

# 実API生成の可否。既定は false。true にできるのは仕様第16章のA3.5／A5のみ
APP_LIVE_API_ENABLED=false

# 全体上限額（USD）。未設定のままでは実API生成を行わない（仕様第11章）
APP_GLOBAL_COST_CAP_USD=

# 事業者APIキー。A3.5以降で使用。値をチャット・ログ・コミットに出さない
# Tripo: https://api.tripo3d.ai/v2/openapi へ Authorization: Bearer で送られる
# Meshy: https://api.meshy.ai/openapi/v1 へ Authorization: Bearer で送られる（msy_ 始まり）
TRIPO_API_KEY=
MESHY_API_KEY=

# 成果物を取得してよいホスト（カンマ区切り）。既定は空で、設定しない限り取得しない。
# 事業者が成果物をどのホストから配信するかを確認してから設定する（仕様第12章）
# Tripo：未確認。実際の成果物URLで確かめてから入れる
APP_TRIPO_DOWNLOAD_HOSTS=
# Meshy：公式資料で assets.meshy.ai と確認済み（docs/provider-contracts.md 第2.6節）。
# 実生成を始めるときに APP_MESHY_DOWNLOAD_HOSTS=assets.meshy.ai を設定する
APP_MESHY_DOWNLOAD_HOSTS=

# Tripo公式SDKは import 時に第三者のIP位置情報サービスへ問い合わせる実装のため、
# アダプター側で必ず 1 を設定する（このファイルの値は控え）
TRIPO_DISABLE_GEO_DETECTION=1

# 校正対象件数（仕様第10章「最初の5件（設定で変更）」）。講師1名運用のため既定0
APP_CALIBRATION_TARGET_COUNT=0

# セッション有効期限（時間）
APP_SESSION_TTL_HOURS=12
