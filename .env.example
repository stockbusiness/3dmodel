# ダミー値のみ。実際の値は .env に記入し、.env はコミットしない（仕様第12章）

# 32バイト以上のランダム文字列。生成例: python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=CHANGE_ME_dummy_secret_key_do_not_use_in_production

# データ保存先（公開ディレクトリ外）。DB・画像・GLBはこの下に置く
APP_DATA_DIR=./data

# 実API生成の可否。既定は false。true にできるのは仕様第16章のA3.5／A5のみ
APP_LIVE_API_ENABLED=false

# 全体上限額（USD）。未設定のままでは実API生成を行わない（仕様第11章）
APP_GLOBAL_COST_CAP_USD=

# 事業者APIキー。A3以降で使用。値をチャット・ログ・コミットに出さない
TRIPO_API_KEY=
MESHY_API_KEY=

# 校正対象件数（仕様第10章「最初の5件（設定で変更）」）。講師1名運用のため既定0
APP_CALIBRATION_TARGET_COUNT=0

# セッション有効期限（時間）
APP_SESSION_TTL_HOURS=12
